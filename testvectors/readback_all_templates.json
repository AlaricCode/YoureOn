  "yaml": "version: 2\nkind: rules\nparticipants:\n  - 7dEr7cjNoH37VgRJoXHHeJHNvZmZh45xHCAZMZp3UYa3\n  - FJQ4C4H9P1Dx9NR9tYaqzX9E3xL2oSMvxetkuqJA25Tq\nsides: [0, 1]\nentities:\n  runner: person(any)\n  ball: object(\"tennis ball\")\n  cup: object(\"red cup\")\n  mark: region(line)\n  pad: region(zone)\nlegs:\n  - id: 1\n    actor_bound: false\n    success: (ball overlaps cup and ball inside cup.interior) or (ball above cup and ball below pad)\n    rule: success\n    attempt_window_s: 5s\n  - id: 2\n    actor_bound: false\n    success: runner behind mark or runner beyond mark\n    rule: never(success)\n    attempt_window_s: 5s\n  - id: 3\n    actor_bound: false\n    success: ball near cup 300 and ball moving\n    rule: count(success) <= 2\n    attempt_window_s: 5s\n  - id: 4\n    actor_bound: false\n    valid_attempt: runner standing\n    success: ball enters pad then_within 2s ball leaves pad\n    rule: count(success) > 1 within attempts 3\n    attempt_window_s: 7.5s\n  - id: 5\n    actor_bound: false\n    success: ball present and cup intact\n    rule: holds(success) for 5s\n    attempt_window_s: 5s\n  - id: 6\n    actor_bound: false\n    success: ball at_rest 1.5s and (not ball speed > 400)\n    rule: success before 90s\n    attempt_window_s: 5s\n  - id: 7\n    actor_bound: false\n    success: (ball direction up for_duration 1s) before 20s\n    rule: count(success) != 0\n    attempt_window_s: 5s\n  - id: 8\n    actor_bound: false\n    success: (ball disappears_into cup.opening or ball touches cup) or ((ball crosses mark and ball released_by runner) or rep_count(runner) == 5)\n    rule: count(success) < 3\n    attempt_window_s: 5s\noutcome: side(B) wins iff (leg 1 and (not leg 2)) or (leg 3 and (leg 4 or leg 5)); else side(A)\nstake_each: 1250000\ntime_limit_s: 120\n",
  "readback": [
    "(tennis ball overlaps red cup and tennis ball is inside the inside of red cup) or (tennis ball is above red cup and tennis ball is below the zone)",
    "Never: someone is behind the line or someone is past the line",
    "tennis ball is near red cup and tennis ball is moving, at most 2 times",
    "Counts if: someone is standing",
    "Wins an attempt if: tennis ball enters the zone, then within 2s, tennis ball leaves the zone",
    "Needs more than 1 of 3 attempts",
    "tennis ball is visible and red cup stays standing for 5s straight",
    "tennis ball stays still for 1.5s and not: tennis ball moves more than 400 within 1m 30s",
    "tennis ball moves up for 1s before 20s, not exactly 0 times",
    "tennis ball goes into the opening of red cup or tennis ball touches red cup or (tennis ball crosses the line and someone releases tennis ball) or someone does exactly 5 reps, fewer than 3 times",
    "Maya win if (leg 1 and not leg 2) or (leg 3 and (leg 4 or leg 5)); otherwise Alex win",
    "$1.25 each",
    "Time limit 2m"
  ],
