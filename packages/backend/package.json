{
  "name": "@verdict/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Verdict backend: API, WebSocket hub, providers, mock/devnet Solana client (CONTRACTS.md §12–§13)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:e2e": "tsx scripts/demo-e2e.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "@verdict/engine": "*",
    "bs58": "^6.0.0",
    "fastify": "^5.12.8",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
