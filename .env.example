# Verdict backend configuration (docs/CONTRACTS.md §13).
#
# Copy to .env (git-ignored) or just start the backend: on first run it creates
# .env and generates FEE_PAYER_KEY, JUDGE_KEY_0..2, BIOMETRIC_KEY and
# ELEVENLABS_TOOL_SECRET. Never commit .env or any keypair.
#
# Every provider defaults to mock/off: `npm test` and `npm run demo:e2e` run
# offline with no keys and no money.

# --- Spend guard -------------------------------------------------------------
# Modes that can incur cost (real LLMs, ElevenLabs, PERCEPTION_PROVIDER=nosana|http,
# SP1_PROVER=network, GEMINI_HEDGE=live) refuse to start (SPEND_DISABLED) unless
# ALLOW_SPEND=1. Never set it in scripts or CI.
# ALLOW_SPEND=

# --- Server ------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Externally reachable base URL (default http://127.0.0.1:$PORT)
# PUBLIC_URL=
# Users, huddles, drafts, bets mirror, booth, keeper state, chunks, exhibits (§12.7)
DATA_DIR=./.data
LOG_LEVEL=info

# --- Solana ------------------------------------------------------------------
# mock: in-memory chain (engine chainModel) | devnet: Solana devnet (free)
SOLANA_MODE=mock
# mock | quicknode | rpc_ws   (mock is required with SOLANA_MODE=mock)
CHAIN_EVENTS_SOURCE=mock
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WS_URL=
# Default: the address in packages/backend/idl/verdict.json
# VERDICT_PROGRAM_ID=
# Devnet: unset = backend-created test mint (mint authority = fee payer)
# USDC_MINT=

# --- Backend keys (base58 64-byte secret keys; generated on first run) -------
# FEE_PAYER_KEY=
# ORACLE_KEY defaults to FEE_PAYER_KEY
# ORACLE_KEY=
# JUDGE_KEY_0=
# JUDGE_KEY_1=
# JUDGE_KEY_2=
# AES-256-GCM key for biometric templates at rest (32-byte hex)
# BIOMETRIC_KEY=

# --- Webhook secrets ---------------------------------------------------------
# Required with CHAIN_EVENTS_SOURCE=quicknode (§12.5 HMAC)
# QUICKNODE_SECRET=
# Header x-verdict-tool-secret for POST /v1/webhooks/elevenlabs/tool
# ELEVENLABS_TOOL_SECRET=

# --- Providers (default first) -----------------------------------------------
# mock | anthropic | openai | gemini | xai
COMPILER_PROVIDER=mock
ADVOCATE_PROVIDER=mock
# Comma list of 3; J0 must be video-capable (mock | gemini)
JUDGE_PROVIDERS=mock,mock,mock
# mock | elevenlabs
AGENT_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
SFX_PROVIDER=mock
# mock | nosana | http
PERCEPTION_PROVIDER=mock
# PERCEPTION_URL=
# pass | fail | cross_fail | motion | low_conf | no_identity | oversize | occlusion
MOCK_SCENARIO=pass
# mock | http (local sidecars, free)
DETECTOR_PROVIDER=mock
# DETECTOR_URL=http://127.0.0.1:8091
IDENTITY_PROVIDER=mock
# EMBEDDER_URL=http://127.0.0.1:8090
# Gemini prediction markets: mock (fixtures) | live (public keyless REST/WS, free)
GEMINI_PROVIDER=mock
GEMINI_BASE_URL=https://api.gemini.com
# World hedge (§11.6): mock | live (costs; needs ALLOW_SPEND=1 + OAuth)
GEMINI_HEDGE=mock
# mock | snarkjs (in-process Groth16, offline, needs circuits/build)
PROVER=mock
# off | mock | network (network costs money)
SP1_PROVER=off

# --- Paid provider credentials (only read when the provider is selected) -----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# NOSANA_API_KEY=
# SP1_PRIVATE_KEY=
