{
  "name": "verdict",
  "version": "0.1.0",
  "private": true,
  "description": "Verdict: spoken bets, settled by an onchain rule interpreter (monorepo root)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vectors": "npm run vectors --workspace=packages/engine --",
    "demo:e2e": "npm run demo:e2e --workspaces --if-present --",
    "gen:dart": "npm run gen:dart --workspace=packages/engine --if-present --"
  }
}
