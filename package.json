{
  "name": "youre-on",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
