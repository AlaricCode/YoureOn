# Root build context (fly.toml builds apps/server/Dockerfile from the repo root). Mirrors
# apps/server/Dockerfile.dockerignore for builders that only read the root file.
**/node_modules
**/.env*
**/*.log
**/target
**/.expo
**/dist
**/*-keypair.json
keys
docs
programs
apps/mobile
# apps/stage is built inside the image (the `stage` build stage); its tests are not needed.
apps/stage/test
.git
# agent worktrees / tool state in the main checkout (each a full copy of the repo)
.claude
.gstack
